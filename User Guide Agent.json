      "parameters": {
        "jsCode": "const item = $input.first();\nconst files = item.json.files;\nconst results = [];\n\nfor (let i = 0; i < files.length; i++) {\n  results.push({\n    json: {\n      filename: files[i].filename,\n      mimetype: files[i].mimetype,\n      size: files[i].size\n    },\n    binary: {\n      data: item.binary[`files_${i}`]\n    }\n  });\n}\n\nreturn results;"
      },
